DATABASE_URL=postgres://postgres:abdullah%40123@localhost:5432/united_keralam
# 24+ random characters, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=UK2026_UnitedKerala_Login_Secure_9xP7mQ2vL8kR4tN6
PORT=3000
# The account with this email or 10-digit mobile becomes admin when it signs up / signs in / links it
ADMIN_IDENT=you@example.com
# Optional: creates this admin on first start so you can sign in without OTP. Put a password here, start once, then delete ADMIN_PASSWORD from .env
ADMIN_MOBILE=
ADMIN_NAME=Admin
ADMIN_PASSWORD=

# Production: set NODE_ENV=production (HTTPS only cookies). Behind a proxy such as Render/Nginx also set TRUST_PROXY=1
NODE_ENV=development
TRUST_PROXY=

# Email OTP (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=UNITED KERALAM <you@gmail.com>

# SMS OTP for mobile numbers. SMS_PROVIDER = msg91 | 2factor | fast2sms | twilio  (fill only the one you use)
SMS_PROVIDER=msg91
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
TWOFACTOR_KEY=
TWOFACTOR_TEMPLATE=
FAST2SMS_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Development only: print OTPs in the server console instead of sending. Never use in production.

# true = create ticket fixtures and sample news on first start (player/tournament stats always start empty)
SEED_DEMO=true
OTP_DEV=true